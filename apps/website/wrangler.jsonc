// Cloudflare Workers static assets. Deployed by Cloudflare's Git integration (Workers Builds):
// build command `pnpm --filter @reversedock/website build`, deploy command `npx wrangler deploy`
// from apps/website, with SITE_URL set to the public address. See README.md.
{
  "name": "reversedock-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The site is served only at its custom domain: the account's workers.dev address and preview
  // URLs are off, and preview builds for branches are turned off in Workers Builds.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "reversedock.oday-bakkour.com", "custom_domain": true }]
}
