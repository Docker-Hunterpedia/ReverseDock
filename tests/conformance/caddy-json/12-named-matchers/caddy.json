{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":443"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"api.example.org"
									]
								}
							],
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"match": [
												{
													"method": [
														"POST",
														"PUT",
														"DELETE"
													],
													"not": [
														{
															"remote_ip": {
																"ranges": [
																	"10.0.0.0/8"
																]
															}
														}
													]
												}
											],
											"handle": [
												{
													"handler": "static_response",
													"status_code": 403
												}
											]
										},
										{
											"match": [
												{
													"path_regexp": {
														"name": "legacy",
														"pattern": "^/v0/(.*)$"
													}
												}
											],
											"handle": [
												{
													"handler": "static_response",
													"status_code": 410
												}
											]
										},
										{
											"match": [
												{
													"header": {
														"X-Beta": [
															"true"
														]
													}
												}
											],
											"handle": [
												{
													"handler": "reverse_proxy",
													"upstreams": [
														{
															"dial": "beta:8080"
														}
													]
												}
											]
										},
										{
											"match": [
												{
													"expression": {
														"expr": "{http.request.uri.query.debug} == \"1\"",
														"name": "debug"
													}
												}
											],
											"handle": [
												{
													"handler": "reverse_proxy",
													"upstreams": [
														{
															"dial": "debug:8080"
														}
													]
												}
											]
										},
										{
											"handle": [
												{
													"handler": "reverse_proxy",
													"upstreams": [
														{
															"dial": "stable:8080"
														}
													]
												}
											]
										}
									]
								}
							],
							"terminal": true
						}
					]
				}
			}
		}
	}
}
