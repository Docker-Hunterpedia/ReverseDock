{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":443"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"files.example.com"
									]
								}
							],
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "vars",
													"root": "/srv/files"
												},
												{
													"browse": {},
													"handler": "file_server",
													"hide": [
														"./Caddyfile"
													]
												}
											]
										}
									]
								}
							],
							"terminal": true
						}
					]
				}
			}
		},
		"tls": {
			"automation": {
				"policies": [
					{
						"subjects": [
							"files.example.com"
						],
						"issuers": [
							{
								"challenges": {
									"dns": {
										"provider": {
											"api_token": "not-copied-example-value",
											"name": "cloudflare"
										}
									}
								},
								"module": "acme"
							}
						]
					},
					{
						"issuers": [
							{
								"challenges": {
									"dns": {
										"provider": {
											"auth_token": "not-copied-example-value",
											"name": "digitalocean"
										}
									}
								},
								"module": "acme"
							}
						]
					}
				]
			}
		}
	}
}
