{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":443"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"shop.example.com"
									]
								}
							],
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "reverse_proxy",
													"upstreams": [
														{
															"dial": "shop-1:3000"
														},
														{
															"dial": "shop-2:3000"
														}
													],
													"health_checks": {
														"active": {
															"expect_status": 200,
															"interval": 10000000000,
															"timeout": 2000000000,
															"uri": "/healthz"
														},
														"passive": {
															"fail_duration": 30000000000,
															"max_fails": 3
														}
													},
													"load_balancing": {
														"retries": 2,
														"selection_policy": {
															"policy": "least_conn"
														}
													},
													"transport": {
														"dial_timeout": 2000000000,
														"protocol": "http",
														"response_header_timeout": 30000000000
													}
												}
											]
										}
									]
								}
							],
							"terminal": true
						}
					]
				}
			}
		}
	}
}
