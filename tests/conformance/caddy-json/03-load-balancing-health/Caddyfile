# Exercises: several upstreams, least_conn, active and passive health checks, retries, transport timeouts.
shop.example.com {
	reverse_proxy shop-1:3000 shop-2:3000 {
		lb_policy least_conn
		lb_retries 2
		health_uri /healthz
		health_interval 10s
		health_timeout 2s
		health_status 200
		fail_duration 30s
		max_fails 3
		transport http {
			dial_timeout 2s
			response_header_timeout 30s
		}
	}
}
