# Exercises: global ACME options (email, ZeroSSL CA, EAB with the HMAC key never copied), DNS-01 with a {env.*} token, a wildcard site.
{
	email ops@example.com
	acme_ca https://acme.zerossl.com/v2/DV90
	acme_eab {
		key_id example-key-id
		mac_key not-copied-example-value
	}
	acme_dns cloudflare {env.CF_API_TOKEN}
}

*.example.com {
	@app host app.example.com
	handle @app {
		reverse_proxy app:8080
	}
}
