{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReverseDock chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "kind": {
      "enum": [
        "Deployment",
        "DaemonSet"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "drainTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "logLevel": {
      "type": "string",
      "minLength": 1
    },
    "logFormat": {
      "enum": [
        "auto",
        "json",
        "text"
      ]
    },
    "watchNamespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
        "maxLength": 253
      },
      "uniqueItems": true
    },
    "kubeconfig": {
      "type": "string"
    },
    "gatewayClass": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "controllerName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceType": {
          "enum": [
            "load_balancer",
            "cluster_ip",
            "node_port"
          ]
        },
        "portRange": {
          "type": "string",
          "pattern": "^[0-9]{1,5}-[0-9]{1,5}$"
        },
        "allowExternalName": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "class": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "claimWithoutClass": {
          "type": "boolean"
        },
        "publishService": {
          "type": "string",
          "pattern": "^([a-z0-9-]+/[a-z0-9.-]+)?$"
        },
        "publishAddress": {
          "type": "string"
        },
        "nginxAnnotations": {
          "type": "boolean"
        },
        "ports": {
          "type": "object",
          "properties": {
            "http": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "https": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "enum": [
                "LoadBalancer",
                "ClusterIP",
                "NodePort"
              ]
            },
            "annotations": {
              "type": "object"
            },
            "externalTrafficPolicy": {
              "enum": [
                "",
                "Cluster",
                "Local"
              ]
            },
            "loadBalancerClass": {
              "type": "string"
            },
            "httpPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "httpsPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingressClass": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "leaderElection": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lease": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      },
      "additionalProperties": false
    },
    "allowAcme": {
      "type": "boolean"
    },
    "config": {
      "type": "object",
      "properties": {
        "extra": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "network": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tlsSecretName": {
              "type": "string"
            },
            "allowedHosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "service": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "annotations": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "medium": {
          "enum": [
            "",
            "Memory"
          ]
        },
        "sizeLimit": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "workloadAnnotations": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "whenUnsatisfiable": {
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "daemonSet": {
      "type": "object",
      "properties": {
        "hostPorts": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "http": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "https": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "privilegedPorts": {
          "enum": [
            "none",
            "sysctl",
            "capability"
          ]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "tokenSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "tlsConfig": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowFrom": {
          "type": "array"
        },
        "adminFrom": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  }
}
