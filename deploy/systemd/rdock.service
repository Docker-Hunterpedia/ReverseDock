# ReverseDock as a systemd service.
#
#   install -m 0755 rdock /usr/local/bin/rdock
#   install -D -m 0644 rdock.yaml /etc/rdock/rdock.yaml
#   install -m 0644 rdock.service /etc/systemd/system/rdock.service
#   systemctl daemon-reload && systemctl enable --now rdock
#
# `systemctl reload rdock` re-reads the configuration (SIGHUP); file changes are picked up
# automatically too. Listener changes apply without a restart.
#
# In-place binary upgrade (ADR-0031): install the new binary over /usr/local/bin/rdock (as root,
# mode 0755), then run `rdock upgrade` (as root, through the admin socket in /var/lib/rdock) or
# `systemctl kill -s USR2 rdock`. The running process hands its listeners to the new one and
# tells systemd the new main PID (`NotifyAccess=main`); it drains for `upgrade.drain` and exits.
# `systemctl stop` ends both while one drains (the default KillMode=control-group).
[Unit]
Description=ReverseDock reverse proxy
Documentation=https://github.com/Docker-Hunterpedia/ReverseDock
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# The old process names the new one as main process after a binary upgrade (MAINPID=).
NotifyAccess=main
ExecStart=/usr/local/bin/rdock run --config /etc/rdock/rdock.yaml --data-dir /var/lib/rdock
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
Environment=RDOCK_LOG_FORMAT=json

# Unprivileged, with only the right to bind ports below 1024.
DynamicUser=yes
StateDirectory=rdock
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# @system-service includes @process (fork, execve), which a binary upgrade needs to start the
# new process; nothing was widened for it.
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
